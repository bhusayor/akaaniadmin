# Base URL of the staging backend the /api-test screen talks to.
# No trailing slash needed; one is trimmed if present.
#
# Copy this file to .env.local and fill it in, or export the variable
# before `npm run dev`. Vite reads env files at startup only, so restart
# the dev server after changing it.
#
# The browser never calls this URL directly: the dev server proxies
# /staging-api/* to it (see vite.config.js), which sidesteps CORS.
STAGING_API_URL=https://staging.example.com/api

# Test account for the "Log in with test account" button on /api-test and
# for `npm run staging:token`. Read by the dev server only; the password is
# never sent to the browser. Logs in through the user login,
# POST /v1/auth/login.
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
